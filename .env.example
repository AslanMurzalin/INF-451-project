# Environment Configuration Template
PROJECT_NAME="AI-Enhanced Student Feedback Analysis System"
API_V1_STR=/api/v1

SECRET_KEY=replace_with_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_REGISTRATION_SECRET=admin-secret-dev-key

COOKIE_SECURE=False
COOKIE_SAMESITE=lax

DEFAULT_RATE_LIMIT=100/minute
AUTH_RATE_LIMIT=10/minute

# Redis URL for caching & rate limiting
REDIS_URL=redis://localhost:6379/0

# Database Configuration:
DATABASE_URL=sqlite:///./feedback_system.db
# Cloud DB: DATABASE_URL=postgresql://user:password@cloud-host.neon.tech/dbname?sslmode=require

BACKEND_CORS_ORIGINS=["*"]
